# docker/pi and docker/laptop both build with the repo root as context (see
# their docker-compose.yaml `context: ../../`), but their Dockerfiles only
# `COPY src ./src` - everything else here just bloats the build context that
# gets tarred up and sent to the Docker daemon on every `docker compose
# build`. These directories are colcon build output (regenerated by
# build_packages.sh / build_packages_pi.sh) and can run into the hundreds of
# MB - GBs.
build/
install/
log/
build_pi/
install_pi/
log_pi/

# Local build trees checked into a package's own source dir (e.g. the
# YDLidar SDK under src/ydlidar_x3/YDLidar-SDK-master/build) - rebuilt fresh
# for the container's target architecture instead of reusing a host build.
**/build/

.git/
**/.git/
